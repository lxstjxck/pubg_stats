{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PUBG Ranked Overlay",
  "version": "1.0.0",
  "identifier": "com.pubgranked.overlay",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PUBG Ranked Overlay",
        "width": 920,
        "height": 680,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
